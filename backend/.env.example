# Copy to backend/.env (gitignored) and fill in for local dev/testing.
# Google OAuth (Desktop app client) — Google Cloud Console → APIs & Services →
# Credentials → Create Credentials → OAuth client ID → Application type: Desktop app.
# Enable the Drive API first. Real values are baked into shipped builds via CI
# secrets (see .github/workflows/build.yml) — end users never set these.
ARBOR_GOOGLE_CLIENT_ID=
ARBOR_GOOGLE_CLIENT_SECRET=
